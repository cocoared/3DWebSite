# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# blender（blender/build_jewels.py で作り直せる中間ファイル。Blender の自動バックアップ .blend1 も含む）
/blender/*.blend
/blender/*.blend1
/blender/__pycache__/

# デザインの参照画像（外部の画像を含むため、公開リポジトリには入れず手元だけに置く）
/.claude/references/
